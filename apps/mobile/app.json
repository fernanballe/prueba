{
  "expo": {
    "name": "WorldDex",
    "slug": "worlddex",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "worlddex",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#f5f0e8"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.worlddex.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "WorldDex necesita tu ubicación para verificar visitas GPS a países.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "WorldDex necesita tu ubicación para registrar visitas a países."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#f5f0e8"
      },
      "package": "com.worlddex.app",
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "WorldDex necesita tu ubicación para verificar visitas GPS."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#c9a84c"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
